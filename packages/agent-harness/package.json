{
  "name": "@memorall/agent-harness-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "core",
    "langgraph",
    "standard",
    "sandbox",
    "mcp",
    "browser",
    "node",
    "compatibility",
    "full"
  ],
  "scripts": {
    "build": "node ../../tools/run-typescript.mjs native -b tsconfig.json --pretty false",
    "clean": "node ../../tools/run-typescript.mjs native -b tsconfig.json --clean",
    "dev": "node ../../tools/run-typescript.mjs native -b tsconfig.json --watch --preserveWatchOutput --pretty",
    "watch": "yarn dev",
    "typecheck": "node ../../tools/run-typescript.mjs native -b tsconfig.json --pretty false",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
