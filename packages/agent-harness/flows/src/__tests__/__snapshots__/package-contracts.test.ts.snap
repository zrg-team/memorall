exports[`Memorall flow registered contracts > registers every core tool contract 2`] = `
[
  {
    "description": "Perform advanced mathematical calculations across arithmetic, statistics, and scientific operations",
    "name": "calculator",
    "parameters": {
      "properties": {
        "a": {
          "description": "Primary number",
          "type": "number",
        },
        "b": {
          "description": "Secondary number",
          "type": "number",
        },
        "operation": {
          "enum": [
            "add",
            "subtract",
            "multiply",
            "divide",
            "power",
            "modulo",
            "nth_root",
            "sqrt",
            "abs",
            "negate",
            "percentage",
            "sum",
            "average",
            "min",
            "max",
            "round",
            "floor",
            "ceil",
            "ln",
            "log10",
            "log",
            "sin",
            "cos",
            "tan",
            "factorial",
            "gcd",
            "lcm",
          ],
          "type": "string",
        },
        "precision": {
          "description": "Decimal precision for round/floor/ceil",
          "type": "number",
        },
        "values": {
          "description": "List of values for aggregate operations",
          "items": {
            "type": "number",
          },
          "type": "array",
        },
      },
      "required": [
        "operation",
      ],
      "type": "object",
    },
  },
  {
    "description": "Clear sandbox container logs.",
    "name": "container_clear_logs",
    "parameters": {
      "properties": {},
      "type": "object",
    },
  },
  {
    "description": "Run an arbitrary sandbox shell command. The call waits up to waitTimeoutMs (default 10000). If the result has completed=false, continue with container_listen_command using the returned commandId and nextOffset.",
    "name": "container_execute_command",
    "parameters": {
      "properties": {
        "command": {
          "description": "Shell command to execute.",
          "type": "string",
        },
        "commandTimeoutMs": {
          "description": "Optional hard timeout for the command itself.",
          "type": "number",
        },
        "cwd": {
          "description": "Optional working directory inside the sandbox.",
          "type": "string",
        },
        "env": {
          "additionalProperties": {
            "type": "string",
          },
          "description": "Optional environment variables to prefix for this command.",
          "type": "object",
        },
        "waitTimeoutMs": {
          "description": "How long to wait for output or completion before returning (default 10000).",
          "type": "number",
        },
      },
      "required": [
        "command",
      ],
      "type": "object",
    },
  },
  {
    "description": "Check whether a file or directory exists in container FS.",
    "name": "container_exists",
    "parameters": {
      "properties": {
        "path": {
          "description": "Virtual path to check (absolute or relative).",
          "type": "string",
        },
      },
      "required": [
        "path",
      ],
      "type": "object",
    },
  },
  {
    "description": "Fetch API/UI resources through container runtime. Auto-detects JSON vs HTML/text and returns status + body.",
    "name": "container_fetch_resource",
    "parameters": {
      "properties": {
        "body": {
          "description": "Optional request body string.",
          "type": "string",
        },
        "headers": {
          "additionalProperties": {
            "type": "string",
          },
          "description": "Optional request headers.",
          "type": "object",
        },
        "method": {
          "description": "HTTP method (default GET).",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS",
          ],
          "type": "string",
        },
        "responseType": {
          "description": "Response parser mode (default auto).",
          "enum": [
            "auto",
            "json",
            "text",
            "html",
          ],
          "type": "string",
        },
        "timeoutMs": {
          "description": "Request timeout in milliseconds (default 15000).",
          "type": "number",
        },
        "url": {
          "description": "Resource URL to fetch.",
          "type": "string",
        },
      },
      "required": [
        "url",
      ],
      "type": "object",
    },
  },
  {
    "description": "Get recent sandbox container logs.",
    "name": "container_get_logs",
    "parameters": {
      "properties": {
        "level": {
          "description": "Optional log level filter.",
          "enum": [
            "log",
            "info",
            "warn",
            "error",
            "debug",
          ],
          "type": "string",
        },
        "limit": {
          "description": "Maximum number of log entries to return (default 100).",
          "type": "number",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Install an npm package in the sandbox container.",
    "name": "container_install_package",
    "parameters": {
      "properties": {
        "packageSpec": {
          "description": "Package spec, e.g. react, lodash@latest, or @types/node.",
          "type": "string",
        },
        "save": {
          "description": "Save as dependency in package.json (default true).",
          "type": "boolean",
        },
        "saveDev": {
          "description": "Save as devDependency in package.json (default false).",
          "type": "boolean",
        },
      },
      "required": [
        "packageSpec",
      ],
      "type": "object",
    },
  },
  {
    "description": "List currently running sandbox commands.",
    "name": "container_list_commands",
    "parameters": {
      "properties": {},
      "type": "object",
    },
  },
  {
    "description": "List all running sandbox servers.",
    "name": "container_list_servers",
    "parameters": {
      "properties": {},
      "type": "object",
    },
  },
  {
    "description": "Continue listening to a previously started sandbox command. Returns only new stdout/stderr since the supplied offset.",
    "name": "container_listen_command",
    "parameters": {
      "properties": {
        "commandId": {
          "description": "Command session ID returned by container_execute_command.",
          "type": "string",
        },
        "offset": {
          "description": "Last nextOffset received from the command session.",
          "type": "number",
        },
        "waitTimeoutMs": {
          "description": "How long to wait for more output or completion before returning (default 10000).",
          "type": "number",
        },
      },
      "required": [
        "commandId",
        "offset",
      ],
      "type": "object",
    },
  },
  {
    "description": "Render a running sandbox web server page (Vite, Next.js, Express HTML) via an iframe and return the fully rendered HTML. Use this for ALL web UI page previews — never use container_request_server for this purpose.",
    "name": "container_render_server",
    "parameters": {
