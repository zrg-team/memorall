          "type": "string",
        },
        "path": {
          "description": "Directory (or exact file path) to search (default: "/"). If a file path is provided, searches only that file.",
          "type": "string",
        },
        "pattern": {
          "description": "Regex pattern to search for in file content",
          "type": "string",
        },
      },
      "required": [
