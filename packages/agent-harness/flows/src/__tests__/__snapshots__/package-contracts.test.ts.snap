          "description": "Optional bind hostname.",
          "type": "string",
        },
        "kind": {
          "description": "Server framework kind. Use "auto" (or omit) to detect from config files (vite.config.*, next.config.*) in projectDir. Use "express", "vite", or "next" to override explicitly.",
