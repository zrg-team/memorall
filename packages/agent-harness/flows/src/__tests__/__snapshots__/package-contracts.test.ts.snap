          "description": "Optional selector for a focused read.",
          "type": "string",
        },
        "sessionId": {
          "description": "Active web session to read.",
          "type": "string",
        },
        "timeoutMs": {
          "description": "Navigation/load timeout used when opening by URL.",
          "type": "number",
        },
        "url": {
          "description": "Open first, then read. Use with no sessionId.",
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Search one or more search engines (Google, Bing, DuckDuckGo, Yahoo, Brave) with a single query and get structured results — title, URL, snippet — per engine. Use this instead of manually opening a search engine URL and reading the page. Engines are queried sequentially.",
    "name": "web_search",
    "parameters": {
      "properties": {
        "engines": {
          "description": "Comma-separated engines to search. Use "all" for all engines, or any combination of: google, bing, duckduckgo, yahoo, brave. Default: "duckduckgo,brave,bing". Example: "google,bing".",
          "type": "string",
