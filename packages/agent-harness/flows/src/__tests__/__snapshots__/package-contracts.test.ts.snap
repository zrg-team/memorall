            "absent",
          ],
          "type": "string",
        },
        "timeoutMs": {
          "description": "Total wait timeout.",
          "type": "number",
        },
        "url": {
          "description": "Open first, then wait.",
          "type": "string",
        },
        "waitMode": {
          "description": "Wait mode. \`render\` waits for page snapshot stability, \`selector\` waits for a DOM selector state, \`time\` waits a fixed duration.",
          "enum": [
