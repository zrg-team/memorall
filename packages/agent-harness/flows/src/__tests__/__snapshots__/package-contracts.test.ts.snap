  },
  {
    "description": "Wait for page render stability, selector state, or a fixed time in a web session.",
    "name": "web_wait",
    "parameters": {
      "properties": {
        "browserMode": {
          "description": "Open mode when no sessionId is provided. Leave it out for a window; \`iframe\` only for a local server.",
          "enum": [
