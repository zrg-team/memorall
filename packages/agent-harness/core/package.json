{
  "name": "@memorall/agent-harness-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "node ../../../tools/run-typescript.mjs native -b",
    "clean": "node ../../../tools/run-typescript.mjs native -b --clean",
    "dev": "node ../../../tools/run-typescript.mjs native -b --watch --preserveWatchOutput --pretty",
    "watch": "yarn dev",
    "typecheck": "node ../../../tools/run-typescript.mjs native -b --pretty false",
    "test": "vitest run --config ../vitest.config.ts core",
    "pack": "yarn pack"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
