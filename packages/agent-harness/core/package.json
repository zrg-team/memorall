{
  "name": "@memorall/agent-harness-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config ../vitest.config.ts core",
    "pack": "yarn pack"
  },
  "dependencies": {
    "semver": "^7.7.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8"
  }
}
