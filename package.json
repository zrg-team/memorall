  "engines": {
    "node": ">=22.23.1 <23"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "workspaces": [
    "packages/agent-harness",
    "packages/agent-harness/*",
    "apps/web",
    "apps/desktop",
    "apps/desktop/sidecar"
  ],
  "resolutions": {
    "ip-address@npm:10.1.0": "npm:10.5.0",
    "nanoid@npm:5.1.11": "npm:5.1.16"
  },
  "homepage": "https://zrg-team.github.io/memorall/studio/",
  "author": "Zergling <zerglingno2@outlook.com>",
  "scripts": {
    "prepare": "node tools/install-husky-hooks.mjs",
    "postinstall": "patch-package --error-on-fail && node tools/copy-bundled-assets.mjs && node tools/install-husky-hooks.mjs",
    "prepare:dev:extension": "yarn build:harness && node tools/build-manifest.mjs && node tools/copy-bundled-assets.mjs && node tools/generate-transformer-runner-configs.mjs && node tools/prepare-dev.mjs",
    "prepare:build:extension": "yarn build:harness && node tools/build-manifest.mjs && node tools/copy-bundled-assets.mjs && node tools/generate-transformer-runner-configs.mjs",
    "prepare:desktop:sidecar": "node tools/sync-desktop-version.mjs && node tools/stage-tauri-node-runtime.mjs && node tools/prepare-desktop-browser-runtime.mjs",
    "sync:desktop:version": "node tools/sync-desktop-version.mjs",
    "dev": "yarn dev:extension",
    "dev:extension": "yarn prepare:dev:extension && concurrently --kill-others --success first --names harness,extension --prefix-colors cyan,magenta \"yarn dev:harness\" \"yarn dev:extension:runtime\"",
    "dev:extension:no-reload": "yarn prepare:dev:extension && concurrently --kill-others --success first --names harness,extension --prefix-colors cyan,magenta \"yarn dev:harness\" \"yarn dev:extension:runtime:no-reload\"",
    "dev:extension:runtime": "cross-env EXTENSION_STRICT_REFS=true extension dev",
    "dev:extension:runtime:no-reload": "cross-env EXTENSION_STRICT_REFS=true extension dev --no-reload",
    "dev:web": "yarn build:harness && vite --config apps/web/vite.config.ts",
    "dev:desktop": "yarn build:harness && yarn prepare:desktop:sidecar && node tools/run-tauri.mjs dev",
    "dev:desktop:frontend": "vite --config apps/desktop/vite.config.ts",
    "dev:harness": "node tools/run-typescript.mjs native -b packages/agent-harness/tsconfig.json --watch --preserveWatchOutput --pretty",
    "build": "yarn build:extension",
    "build:extension": "yarn prepare:build:extension && cross-env EXTENSION_STRICT_REFS=true extension build && node tools/stage-extension-build.mjs chromium && node tools/ensure-content-script-assets.mjs publish/extension/chromium && node tools/check-mv3-remote-code.mjs publish/extension/chromium && node tools/check-patched-dependencies.mjs publish/extension/chromium",
    "build:extension:chrome": "yarn prepare:build:extension && cross-env EXTENSION_STRICT_REFS=true extension build --browser=chrome && node tools/stage-extension-build.mjs chrome && node tools/ensure-content-script-assets.mjs publish/extension/chrome && node tools/check-mv3-remote-code.mjs publish/extension/chrome && node tools/check-patched-dependencies.mjs publish/extension/chrome",
    "build:extension:edge": "yarn prepare:build:extension && cross-env EXTENSION_STRICT_REFS=true extension build --browser=edge && node tools/stage-extension-build.mjs edge && node tools/ensure-content-script-assets.mjs publish/extension/edge && node tools/check-mv3-remote-code.mjs publish/extension/edge && node tools/check-patched-dependencies.mjs publish/extension/edge",
    "build:extension:firefox": "yarn prepare:build:extension && cross-env EXTENSION_STRICT_REFS=true extension build --browser=firefox && node tools/stage-extension-build.mjs firefox && node tools/ensure-content-script-assets.mjs publish/extension/firefox",
    "build:extension:all": "yarn prepare:build:extension && cross-env NODE_ENV=production EXTENSION_STRICT_REFS=true extension build --browser=chrome,edge && node tools/stage-extension-build.mjs chrome edge && node tools/ensure-content-script-assets.mjs publish/extension/chrome publish/extension/edge && node tools/prepare-production.mjs && node tools/check-mv3-remote-code.mjs publish/extension/chrome publish/extension/edge && node tools/check-patched-dependencies.mjs publish/extension/chrome publish/extension/edge",
    "build:web": "yarn build:harness && vite build --config apps/web/vite.config.ts && node tools/check-patched-dependencies.mjs publish/web",
    "build:desktop": "yarn prepare:desktop:sidecar && node tools/run-tauri.mjs build",
    "build:desktop:frontend": "yarn build:harness && vite build --config apps/desktop/vite.config.ts && node tools/check-patched-dependencies.mjs publish/desktop/frontend",
    "build:desktop:windows": "node tools/desktop-platform-guard.mjs windows && yarn build:desktop",
    "build:desktop:macos": "node tools/desktop-platform-guard.mjs macos && yarn build:desktop",
    "build:desktop:linux": "node tools/desktop-platform-guard.mjs linux && yarn build:desktop",
    "build:harness": "node tools/run-typescript.mjs native -b packages/agent-harness/tsconfig.json --pretty false",
    "build:all": "yarn build:extension:all && yarn build:web && yarn build:desktop",
    "package": "yarn package:extension:all",
    "package:extension": "yarn package:extension:all",
    "package:extension:chrome": "yarn build:extension:chrome && node tools/package-extension.mjs chrome",
    "package:extension:edge": "yarn build:extension:edge && node tools/package-extension.mjs edge",
    "package:extension:all": "yarn build:extension:all && node tools/package-extension.mjs chrome edge",
    "package:web": "yarn build:web",
    "package:desktop": "yarn build:desktop",
    "package:desktop:windows": "yarn build:desktop:windows",
    "package:desktop:macos": "yarn build:desktop:macos",
    "package:desktop:linux": "yarn build:desktop:linux",
    "package:harness": "yarn build:harness && node tools/pack-agent-harness.mjs",
    "package:all": "yarn package:extension:all && yarn package:web && yarn package:desktop",
    "deploy:web": "yarn deploy:web:github-pages",
    "deploy:web:github-pages": "yarn package:web && node tools/deploy-github-pages.mjs",
    "deploy:web:github-pages:dry-run": "yarn package:web && node tools/deploy-github-pages.mjs --dry-run",
    "start": "yarn start:extension",
    "start:extension": "extension start",
    "preview": "yarn preview:extension",
    "preview:extension": "extension preview",
    "preview:web": "vite preview --config apps/web/vite.config.ts",
    "serve:web": "node tools/serve-static-web.mjs",
    "typecheck": "yarn build:harness && node tools/run-typescript.mjs native --noEmit",
    "typecheck:harness": "node tools/run-typescript.mjs native -b packages/agent-harness/tsconfig.json --pretty false",
    "typecheck:desktop:sidecar": "yarn build:harness && node tools/run-typescript.mjs native --noEmit -p apps/desktop/sidecar/tsconfig.json",
    "test": "yarn test:unit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:harness": "vitest run --config packages/agent-harness/vitest.config.ts",
    "test:desktop:sidecar": "vitest run --config apps/desktop/sidecar/vitest.config.ts",
    "test:desktop:browser-runtime": "node tools/smoke-desktop-browser-sidecar.mjs",
    "test:sandbox:unit": "vitest run src/services/agent-sandbox/__tests__ src/services/sandbox-container/__tests__ packages/agent-harness/flows/src/__tests__/agent-sandbox-tools.test.ts packages/agent-harness/flows/src/__tests__/tool-registry.test.ts packages/agent-harness/flows/src/__tests__/flow-engine-harness.test.ts src/services/__tests__/flow-service-adapters.logic.test.ts",
    "test:e2e:sandbox": "yarn build:extension && playwright test -c playwright.sandbox.config.ts --project=deterministic",
    "test:e2e:sandbox:network": "yarn build:extension && playwright test -c playwright.sandbox.config.ts --project=network",
    "test:e2e:extension:dev": "node tools/run-extension-e2e.mjs dev",
    "test:e2e:extension:build": "node tools/run-extension-e2e.mjs build",
    "test:e2e:extension:local-model": "cross-env MEMORALL_EXTENSION_PATH=publish/extension/chrome MEMORALL_EXTENSION_MODE=chrome-production MEMORALL_LOCAL_MODEL_E2E=1 playwright test -c playwright.extension.config.ts --grep \"selects a local model\" --repeat-each=2",
    "test:e2e:extension": "yarn test:e2e:extension:dev && yarn test:e2e:extension:build",
    "test:e2e:web": "yarn build:web && playwright test -c playwright.web.config.ts",
    "test:e2e:web:local-model": "yarn build:web && cross-env MEMORALL_LOCAL_MODEL_E2E=1 playwright test -c playwright.web.config.ts --grep \"selects a local CPU model\"",
    "test:e2e:desktop": "node e2e/desktop/native-smoke.mjs --build",
    "test:e2e:desktop:built": "node e2e/desktop/native-smoke.mjs",
    "test:e2e:desktop:windows:local-model": "cross-env MEMORALL_LOCAL_MODEL_E2E=1 node e2e/desktop/native-smoke.mjs --build",
    "check": "yarn check:branch-name && yarn check:patches && yarn check:patched && yarn check:pglite:browser && yarn check:dependencies && yarn check:extension:no-reload && yarn check:desktop:spawn && yarn check:desktop:dmg-retry && yarn check:duplicate-modules && yarn check:platform:boundaries && yarn typecheck && yarn test:unit",
    "check:branch-name": "node --test tools/check-branch-name.test.mjs tools/check-reference-transaction.test.mjs && node tools/check-branch-name.mjs",
    "check:dependencies": "node tools/check-dependency-cohorts.mjs",
    "check:extension:no-reload": "node --test tools/check-extension-no-reload.test.mjs && node tools/check-extension-no-reload.mjs",
    "check:desktop:spawn": "node --test tools/check-desktop-detached-spawn.test.mjs && node tools/check-desktop-detached-spawn.mjs",
    "check:desktop:dmg-retry": "node --test tools/tauri-dmg-retry.test.mjs",
    "check:duplicate-modules": "node --test tools/check-duplicate-modules.test.mjs && node tools/check-duplicate-modules.mjs",
    "check:patches": "node tools/check-patch-package.mjs",
    "check:desktop:version": "node tools/sync-desktop-version.mjs --check",
    "check:patched": "node tools/check-patched-dependencies.mjs",
    "check:pglite:browser": "node --test tools/check-pglite-browser-process.test.mjs && node tools/check-pglite-browser-process.mjs",
    "check:mv3": "node tools/check-mv3-remote-code.mjs",
    "check:harness:boundaries": "node tools/check-agent-harness-boundaries.mjs",
    "check:harness": "yarn check:harness:boundaries && yarn typecheck:harness && yarn test:harness && yarn package:harness && yarn smoke:harness:consumers",
    "check:platform:boundaries": "node tools/check-platform-boundaries.mjs",
    "check:platform:bundles": "node tools/check-platform-bundles.mjs",
    "check:sandbox": "yarn typecheck && yarn test:sandbox:unit && yarn test:e2e:sandbox",
    "smoke:harness:consumers": "node tools/smoke-agent-harness-consumers.mjs",
    "clean": "node tools/clean-extension-output.mjs",
    "clean:harness": "node tools/run-typescript.mjs native -b packages/agent-harness/tsconfig.json --clean",
    "lint": "yarn format:check",
    "format": "biome format --write ./src ./scripts",
    "format:check": "biome format ./src ./scripts",
    "test:patches": "node --test tools/check-patch-package.test.mjs",
    "assets:bundled": "node tools/copy-bundled-assets.mjs",
    "assets:icons": "node tools/generate-icons.mjs",
    "audit:llm-models": "node tools/audit-llm-models.mjs",
    "benchmark:openui": "node tools/benchmark-openui-streaming.mjs",
    "qa:hyperframes-export": "node tools/hyperframes-export-parity-qa.mjs"
  },
