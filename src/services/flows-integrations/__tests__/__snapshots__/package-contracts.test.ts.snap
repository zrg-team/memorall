  },
  {
    "description": "Read and change spreadsheets (.xlsx), Word documents (.docx), presentations (.pptx), whiteboards (.whiteboard) and PDFs with their apps' own commands. Call with only file_path first: it lists the app's commands and shows the file. Then pass commands: [{ name, args }]; they run in order and the file is saved once. Never write these files with document_fs_write or document_fs_edit.",
    "name": "document_fs_app",
    "parameters": {
      "properties": {
        "commands": {
          "description": "Commands to run in order; the file is saved once, after them. A failed command stops the rest. Without commands: the app's commands and the file at a glance.",
          "items": {
            "properties": {
              "args": {
                "additionalProperties": {},
                "description": "Its arguments, as the command's parameters say.",
                "type": "object",
              },
              "name": {
                "description": "A command the app lists.",
                "type": "string",
              },
            },
            "required": [
