exports[`flows-integrations registered contracts > registers every integrations tool contract 2`] = `
[
  {
    "description": "Safely click a selected element in the active co-agent tab. High-impact or sensitive targets are blocked and require user action.",
    "name": "co_agent_click",
    "parameters": {
      "properties": {
        "index": {
          "description": "Zero-based element index when selector matches multiple elements.",
          "type": "number",
        },
        "message": {
          "description": "Short user-facing reason for the click, shown when confirmation is needed.",
          "type": "string",
        },
        "selector": {
          "description": "Stable CSS selector for the element to click. Use co_agent_observe or co_agent_query first to get this value.",
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Safely type text into a selected text input or textarea in the active co-agent tab. Sensitive fields are blocked.",
    "name": "co_agent_input",
    "parameters": {
      "properties": {
        "index": {
          "description": "Zero-based element index when selector matches multiple elements.",
          "type": "number",
        },
        "message": {
          "description": "Short user-facing reason for the input action, shown when confirmation is needed.",
          "type": "string",
        },
        "selector": {
          "description": "Stable CSS selector for the text input or textarea. Use co_agent_observe or co_agent_query first to get this value.",
          "type": "string",
        },
        "value": {
          "description": "Text to type into the selected input. Defaults to an empty string.",
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Move the visible co-agent cursor to a selector/index or viewport coordinates. Optionally scroll the element into view.",
    "name": "co_agent_move",
    "parameters": {
      "properties": {
        "index": {
          "description": "Zero-based element index when selector matches multiple elements.",
          "type": "number",
        },
        "message": {
          "description": "Short label or explanation to show near the co-agent cursor.",
          "type": "string",
        },
        "mode": {
          "description": "Cursor movement mode: moveTo or jumpTo. Defaults to the page handler behavior.",
          "type": "string",
        },
        "scrollIntoView": {
          "description": "Whether to scroll the selected element into view before pointing.",
          "type": "boolean",
        },
        "selector": {
          "description": "Stable CSS selector for the element to point at. Use co_agent_observe or co_agent_query first to get this value.",
          "type": "string",
        },
