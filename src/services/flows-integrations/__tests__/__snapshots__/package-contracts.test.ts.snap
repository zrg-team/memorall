          "description": "URL to access on the sandbox container server. Accepts: /__virtual__/<port>/path.",
          "type": "string",
        },
        "useIframe": {
          "description": "REQUIRED true for any web server UI page (Vite, Next.js, Express HTML, React, etc.). The iframe renderer waits for the page to fully load before capturing HTML. Set false or omit ONLY for pure API endpoints that return JSON or plain text — those use direct fetch.",
          "type": "boolean",
