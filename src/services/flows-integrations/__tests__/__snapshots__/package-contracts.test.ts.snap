        "cron": {
          "description": "create/edit: 5-field cron in local time: "0 9 * * *" every day 09:00, "30 17 * * 5" Fridays 17:30, "0 */6 * * *" every 6 hours.",
          "type": "string",
        },
        "name": {
          "description": "create/edit: a short name.",
          "type": "string",
        },
        "prompt": {
          "description": "create/edit: what the agent is asked each time it runs.",
          "type": "string",
        },
        "schedule": {
          "description": "edit/delete/pause/resume: the schedule number in the Scheduler.",
          "type": "number",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
  },
  {
    "description": "Read the computer screen: the open windows, the focused window in full (a page outline with refs, a folder listing, a file, or terminal output), and anything the user changed since your last look. The Browser tab is synced again from its page, once the page holds still.",
    "name": "memon_screen",
    "parameters": {
      "description": "Read the computer screen.",
      "properties": {
        "waitSeconds": {
