          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "See the skill library and which skills this agent uses, read a skill's instructions, and (when the user asks) enable, disable, create, edit or delete skills.",
    "name": "memon_skills",
    "parameters": {
      "description": "View and manage the skills this agent uses.",
