  {
    "description": "Act on the computer: click, hover or type on a ref from the latest screen (or click a page point by x, y), press keys, scroll, go back/forward, switch tabs, save a screenshot of the page to Files, or write and save in the Editor. Returns the new screen.",
    "name": "memon_act",
    "parameters": {
      "description": "Act on the computer screen.",
      "properties": {
        "action": {
          "description": "click a ref (a button, link, file or switch), or a page point with x and y; hover a page ref or point (menus that open on hover); press a key (text: Enter, Escape, Tab, ArrowDown, Control+a) on a page ref or the focused element; type text into a field or the editor (e1); toggle a switch or checkbox (text on/off sets it); select an option of a choice (text is the option); describe to see a picture: a page ref (a canvas, an image or any part of the page; an image also gives its address), an image in Files (f3), or with no ref the image the Viewer shows, else the page as it shows; screenshot saves the page as the browser shows it as a PNG file into Files (~/Pictures, or to): the current view, the whole page (capture), a page ref, or a region; scroll the focused window (the page, a file in the Editor or Viewer, or a long list: Files, Tasks, Skills, the Terminal's output, pi's conversation), or with a page ref the area it scrolls in; back/forward the page; select_tab/close_tab by number. Files entries: move/copy into the folder in text, or cut/copy without text to the clipboard, then paste (into the open folder, or into a folder ref). download: save the file at the address in text (or a page image ref) into Files. zip: zip a folder (a Files ref, or its path in text) into Files and hand it to the user to download. unzip: unpack a .zip (a Files ref, or its path in text) beside it, or into the folder in to.",
          "enum": [
            "click",
            "hover",
            "press",
            "type",
            "toggle",
            "select",
            "describe",
            "screenshot",
            "focus",
            "scroll",
            "back",
            "forward",
            "select_tab",
            "close_tab",
            "move",
            "copy",
            "cut",
            "paste",
            "download",
            "zip",
            "unzip",
          ],
          "type": "string",
        },
        "capture": {
          "description": "screenshot: "view" (the default) is what the page shows now; "page" is the whole page, top to bottom (a very long one is cut).",
          "enum": [
            "view",
            "page",
          ],
          "type": "string",
        },
        "direction": {
          "description": "scroll: which way (default down, one screen); top/bottom jump to an end; left/right on a page.",
          "enum": [
            "up",
            "down",
            "left",
            "right",
            "top",
            "bottom",
          ],
          "type": "string",
        },
        "path": {
          "description": "describe: the exact image file path from search results, such as "/agents/Bot/assets/hero.webp" or "~/assets/hero.webp". No Files ref or open Viewer is needed. A folder opens in Files so you can choose an image.",
          "type": "string",
        },
        "ref": {
          "description": "A ref from the latest screen: "b12" (browser), "f3" (files), "e1"/"e2" (editor), or a control of an app window such as "s5" (Studio), "n2" (Tasks), "k3" (Skills), "c1" (Connections), "h4" (Scheduler).",
          "type": "string",
        },
        "region": {
          "description": "screenshot: only this part, in CSS pixels, as the screen gives places ("[b9] canvas 800×600 at 0,120" is { x: 0, y: 120, width: 800, height: 600 }): of the view, or with capture "page", of the page from its top.",
          "properties": {
            "height": {
              "type": "number",
            },
            "width": {
              "type": "number",
            },
            "x": {
              "type": "number",
            },
            "y": {
              "type": "number",
            },
          },
          "required": [
            "x",
            "y",
            "width",
            "height",
          ],
          "type": "object",
        },
        "submit": {
          "description": "type: press Enter after typing (submit a search box).",
          "type": "boolean",
        },
        "tab": {
          "description": "select_tab/close_tab: the tab number from the screen.",
          "type": "number",
        },
        "text": {
          "description": "type: the text (it replaces the field's value; in the editor e1, the whole file). press: the key. select: the option. toggle: on or off. move/copy: the folder to put the entry in. download: the file's address. zip: the folder's path. unzip: the .zip's path.",
          "type": "string",
        },
        "to": {
          "description": "download/zip: a folder (the file keeps its name) or a file path; ~/Downloads by default. unzip: the folder to unpack into; beside the zip by default. screenshot: a folder or a .png path; ~/Pictures by default.",
          "type": "string",
        },
        "x": {
          "description": "click/hover by position on the Browser's page only, in CSS pixels: from the left of the ref (a canvas b9) or, without a ref, of the page's viewport. Other windows (Files, Tasks, the Editor…) take refs, never x/y.",
          "type": "number",
        },
        "y": {
          "description": "click/hover by position: from the top, like x.",
          "type": "number",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
  },
  {
    "description": "Work in the computer's file apps: Spreadsheet (.xlsx), Documents (.docx), Presentation (.pptx), Whiteboard (.whiteboard) and PDF. { path } opens the file in its app and lists the app's commands; { path, commands: [{ name, args }] } runs them and saves the file, which the user sees change in the app's window; { path, help: "<command>" } gives one command's full parameters. Never write these files as text.",
    "name": "memon_app",
    "parameters": {
      "description": "Read and change spreadsheets, Word documents, presentations, whiteboards and PDFs with their apps.",
      "properties": {
        "commands": {
          "description": "Commands to run in order; the file is saved once, after them. A failed command stops the rest. Without commands: the app's commands and the file at a glance.",
          "items": {
            "properties": {
              "args": {
                "additionalProperties": {},
                "description": "Its arguments, as the command's parameters say.",
                "type": "object",
              },
              "name": {
                "description": "A command the app lists.",
                "type": "string",
              },
            },
            "required": [
              "name",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "help": {
          "description": "A command's name: its description and full parameters.",
          "type": "string",
        },
        "path": {
          "description": "The file, e.g. ~/Reports/Q3.xlsx. A path that does not exist yet makes the file. Default: the file open in the app window in front.",
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Hand coding work to pi code, the pi coding agent in its own window: it reads, edits and runs code in the computer's files with its own tools, on the chat's model. A prompt returns when pi's turn ends: it answered or asks you something, failed, or the user stopped it; or sooner, when the user writes to you. Then answer it, steer it, stop it or type into it. The user confirms in the pi code window before you hand it work. Returns a summary and the screen, which shows pi's conversation while its window is in front.",
    "name": "memon_code",
    "parameters": {
      "description": "Drive pi code, the coding agent app on the computer.",
      "properties": {
        "action": {
          "description": ""prompt" hands pi work, or steers it while it works, and waits until its turn ends; "wait" waits for that again; "stop" stops it; "keys" types into its terminal; "new" starts a new pi session; "compact" compacts its conversation; "close" quits pi.",
          "enum": [
            "prompt",
            "wait",
            "stop",
            "keys",
            "new",
            "compact",
            "close",
          ],
          "type": "string",
        },
        "cwd": {
          "description": "prompt: the folder pi works in when this call starts it, e.g. "~/todo-app" (default ~). It stays until pi is closed.",
          "type": "string",
        },
        "key": {
          "description": "keys: a key pressed after text, e.g. "enter" or "escape".",
          "enum": [
            "enter",
            "alt+enter",
            "escape",
            "tab",
            "shift+tab",
            "up",
            "down",
            "right",
            "left",
            "backspace",
            "ctrl+c",
            "ctrl+o",
            "ctrl+t",
          ],
          "type": "string",
        },
        "queue": {
          "description": "A prompt while pi works: "steer" (default) reaches it after its current tool calls, "followUp" once it is done.",
          "enum": [
            "steer",
            "followUp",
          ],
          "type": "string",
        },
        "text": {
          "description": "prompt: the work for pi, standing on its own (the goal, the files, how to check it). keys: the text to type. compact: what the summary should keep.",
          "type": "string",
        },
        "waitSeconds": {
          "description": "The most seconds to wait for pi's turn to end (prompt and wait: 600 by default; 0 returns at once).",
          "type": "number",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
  },
  {
    "description": "See the user's connected apps (Composio apps, MCP servers), their status and tools, and (when the user asks) grant or revoke them for this agent.",
    "name": "memon_connections",
    "parameters": {
      "description": "View the user's connected apps and which ones this agent uses.",
      "properties": {
        "action": {
          "description": "list: the user's connections, numbered, with status and whether you may use them; tools: a connection's tools; refresh: ask it for its tools again; grant/revoke: let this agent use it or stop.",
          "enum": [
            "list",
            "tools",
            "refresh",
            "grant",
            "revoke",
          ],
          "type": "string",
        },
        "connection": {
          "description": "tools/refresh/grant/revoke: the connection's number in the list.",
          "type": "number",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
  },
  {
    "description": "Keep what you remember between chats in Memory.md (and, when the user asks, their standing instructions in Bot.md), one entry at a time. Both files are read at the start of every chat.",
    "name": "memon_memory",
    "parameters": {
      "description": "Remember things between chats in Memory.md, and keep Bot.md.",
      "properties": {
        "action": {
          "description": "list: show the entries, numbered; add: a new entry; update: reword \`entry\`; remove: delete \`entry\`.",
          "enum": [
            "list",
            "add",
            "update",
            "remove",
          ],
          "type": "string",
        },
        "entry": {
          "description": "update/remove (required): the entry number, as [n] in the latest list. A remove moves the entries after it up one, so take numbers from the last memon_memory result, not the start of the chat, and make one change per call.",
          "type": "number",
        },
        "file": {
          "description": "memory (default): Memory.md, what you remember about the user and their work. bot: Bot.md, the user's standing instructions for you — change it only when the user asks to change how you behave in future chats.",
          "enum": [
            "memory",
            "bot",
          ],
          "type": "string",
        },
        "text": {
          "description": "add/update (required): one short, self-contained fact or instruction; for update, the entry's whole new wording.",
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
  },
  {
    "description": "Open an app on the computer and return the screen. Browser opens a url (or a search) and waits for the page to finish drawing itself; Files shows a folder; Editor opens a file; Terminal brings up the shell; Video plays a HyperFrames project or a video file, and with exportMp4 renders the project to an MP4.",
    "name": "memon_open",
    "parameters": {
      "description": "Open an app on the computer, a page in the Browser, or a file.",
      "properties": {
        "app": {
          "description": "The app to open or bring to the front.",
          "enum": [
            "browser",
            "files",
            "editor",
            "terminal",
            "tasks",
            "visualize",
            "video",
          ],
          "type": "string",
        },
        "embedded": {
          "description": "Browser: a local address a Terminal server listens on (http://localhost:PORT) opens embedded; any other opens in a real browser tab, where the user's own servers are. true or false forces one.",
          "type": "boolean",
        },
        "exportMp4": {
          "description": "Video: also export the project to MP4 in the Video window and wait for it; the file is saved as {project}/renders/{name}.mp4.",
          "type": "boolean",
        },
        "newTab": {
          "description": "Browser: open in a new tab and keep the current page.",
          "type": "boolean",
        },
        "path": {
          "description": "Files: the folder to show (default "/"), or a file to open in its app: a .terminal launcher runs in a new Terminal tab, a .studio app opens Studio set up, a .tasks file opens in Tasks. Editor: the file to open as text (a launcher or studio app too, to read or change it without running it); a missing file starts empty and is created on save. Visualize: the .openui file to open. Video: a HyperFrames project folder (or its index.html) or a video file to play.",
          "type": "string",
        },
        "url": {
          "description": "Browser: the page to open. Plain words search DuckDuckGo instead.",
          "type": "string",
        },
      },
      "required": [
        "app",
      ],
      "type": "object",
    },
  },
  {
    "description": "Run a shell command in the Terminal window (the same "/" tree as Files) and return its output with the screen. Long commands keep running and streaming: call again to wait, type into them, or stop them. The Terminal has tabs, each with its own working directory; \`cd dir\` changes the tab's directory for later commands. One long command (a server) keeps running at a time; while it does, any command that finishes (ls, node --check, tests, curl, git, py) runs next to it in any tab, and a second server is stopped.",
    "name": "memon_run",
    "parameters": {
      "description": "Run, wait for, type into, or stop a command in the computer's Terminal, and open, switch or close its tabs.",
      "properties": {
        "closeTab": {
          "description": "Close the Terminal tab given by terminal (default: the tab in front), stopping the command running in it.",
          "type": "boolean",
        },
        "command": {
          "description": "The shell command to run. Leave out to work with the running one.",
          "type": "string",
        },
        "cwd": {
          "description": "Working directory; defaults to the Terminal tab's current one.",
          "type": "string",
        },
        "input": {
          "description": "Type this line into the running command, e.g. an answer to its prompt.",
          "type": "string",
        },
        "saveAs": {
          "description": "Keep \`command\` as a launcher instead of running it, e.g. "Start Landing Page" saves ~/Start Landing Page.terminal on the desktop; opening it runs the command in a new Terminal tab, in \`cwd\` (default: the tab's directory). A path saves it there.",
          "type": "string",
        },
        "stop": {
          "description": "Stop the running command (Ctrl+C).",
          "type": "boolean",
        },
        "terminal": {
          "description": "Terminal tab to work in, e.g. "2", or "new" to open one; it comes to the front so the screen shows its output. Alone, it only switches to that tab. Defaults to the tab in front.",
          "type": "string",
        },
        "waitSeconds": {
          "description": "How long to wait for the command to finish before returning (default 10). With nothing else set, waits for the running command, or just waits when nothing runs.",
          "type": "number",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "View, create, edit, pause, resume or delete this agent's scheduled prompts (runs of this agent at set times) in the Scheduler app. Returns the screen.",
    "name": "memon_schedule",
    "parameters": {
      "description": "View and manage this agent's scheduled prompts in the Scheduler.",
      "properties": {
        "action": {
          "description": "list: show this agent's scheduled prompts; create: add one; edit: change one; delete/pause/resume: one by \`schedule\` number.",
