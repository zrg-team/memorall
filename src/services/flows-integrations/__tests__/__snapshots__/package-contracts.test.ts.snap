            ],
            "type": "object",
          },
          "type": "array",
        },
        "file_path": {
          "description": "The file, e.g. /reports/Q3.xlsx. Apps open .xlsx, .xlsm, .xls, .ods, .docx, .dotx, .docm, .hwp, .hwpx, .pptx, .whiteboard, .pdf. A path that does not exist yet makes the file.",
          "type": "string",
        },
        "help": {
          "description": "A command's name: its description and full parameters.",
          "type": "string",
        },
      },
      "required": [
        "file_path",
      ],
      "type": "object",
    },
  },
