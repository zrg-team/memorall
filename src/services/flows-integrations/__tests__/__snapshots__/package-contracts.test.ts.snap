  {
    "description": "Read earlier messages by ID over a bounded line range. Start in compact mode; switch to detail only when you need a tool call's arguments or output. Line numbers are mode-specific, so keep the same mode when continuing a read.",
    "name": "thread_history_read",
    "parameters": {
      "properties": {
        "fromLine": {
          "description": "Inclusive first line (default: 1)",
          "type": "number",
        },
        "messageIds": {
          "description": "One to eight message IDs returned by thread_history_search",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "mode": {
          "description": "compact (default) renders prose and collapses each tool call and result to one line; detail renders tool arguments and outputs in full. Line numbers differ between modes.",
          "enum": [
            "compact",
            "detail",
          ],
          "type": "string",
        },
        "toLine": {
          "description": "Inclusive last line (default: fromLine + 79, capped at fromLine + 199)",
          "type": "number",
        },
      },
      "required": [
        "messageIds",
      ],
      "type": "object",
    },
  },
  {
    "description": "Search messages from before the current thread separator. Matching is lexical (full-text plus substring), ranked by BM25. Returns message IDs and grep-style excerpts whose line numbers match a compact thread_history_read of the same message.",
    "name": "thread_history_search",
    "parameters": {
      "properties": {
        "limit": {
          "description": "Maximum matched message IDs to return (default: 8)",
          "type": "number",
        },
        "prefixLines": {
          "description": "Context lines before each match (default: 2)",
          "type": "number",
        },
        "query": {
          "description": "Text to find in earlier messages",
          "type": "string",
        },
        "suffixLines": {
          "description": "Context lines after each match (default: 2)",
          "type": "number",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
  },
  {
    "description": "Fetch an image from a URL and save it to the root filesystem. Uses an active web session when available, otherwise downloads directly. Returns the stored file path.",
    "name": "web_fetch_image",
    "parameters": {
      "properties": {
        "file_path": {
          "description": "Where to save the image inside the root filesystem. Default: /resources/images/<filename>",
          "type": "string",
        },
        "sessionId": {
          "description": "Optional active web session whose tab fetches the image. Uses direct fetch when no tab session is available.",
          "type": "string",
        },
        "url": {
          "description": "Image URL to fetch and store in the root filesystem.",
          "type": "string",
        },
      },
      "required": [
        "url",
      ],
      "type": "object",
    },
  },
  {
    "description": "Look at images from the current page. Give it image URLs (from web_dom_action query on 'img') and it returns the pictures themselves for inspection. Use this instead of trying to read image data out of the DOM. Optionally saves them to the root filesystem.",
    "name": "web_read_images",
    "parameters": {
      "properties": {
        "detail": {
          "description": "Vision detail hint. Use 'low' when skimming many images.",
          "enum": [
            "auto",
            "low",
            "high",
          ],
          "type": "string",
        },
        "save_dir": {
          "description": "Also save each image under this directory in the root filesystem, e.g. /resources/images.",
          "type": "string",
        },
        "sessionId": {
          "description": "Web session whose tab fetches the images. Falls back to a direct download.",
          "type": "string",
        },
        "urls": {
          "description": "Image URLs to look at, up to 8. Collect them from web_dom_action (query "img" and read each src).",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "urls",
      ],
      "type": "object",
    },
  },
  {
    "description": "Capture a PNG screenshot of an active web session or a URL and save it to the root filesystem. Returns the saved file path and image dimensions.",
    "name": "web_screenshot",
    "parameters": {
      "properties": {
        "browserMode": {
          "description": "Open mode when opening by URL. Leave it out for a window; \`iframe\` only for a local server.",
          "enum": [
            "iframe",
            "tab",
            "window",
          ],
          "type": "string",
        },
        "file_path": {
          "description": "Where to save the PNG in the root filesystem. Default: /screenshots/screenshot-<timestamp>.png",
          "type": "string",
        },
        "sessionId": {
          "description": "Active web session to capture. Use this when a session is already open.",
          "type": "string",
        },
        "timeoutMs": {
          "description": "Navigation timeout in milliseconds when opening by URL.",
          "type": "number",
        },
        "url": {
          "description": "Open this URL first, then capture. Use when no sessionId is available.",
          "type": "string",
        },
      },
      "type": "object",
    },
  },
]
`;
