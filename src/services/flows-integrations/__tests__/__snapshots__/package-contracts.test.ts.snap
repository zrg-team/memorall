        "timeoutMs": {
          "description": "Execution timeout in milliseconds (default: 1000)",
          "type": "number",
        },
      },
      "required": [
        "code",
      ],
      "type": "object",
    },
  },
  {
    "description": "Edit animation.json by replacing old_string with new_string. Prefer this over lottie_write when changing a small portion of an existing animation (e.g. a color, keyframe value, or single property). By default only the first occurrence is replaced; set replace_all to true to replace every occurrence. Fails if old_string is not found or if the result would not be valid JSON.",
