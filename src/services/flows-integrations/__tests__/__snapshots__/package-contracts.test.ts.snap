          "type": "string",
        },
        "scope": {
          "description": "What to read: metadata, selector, selection, viewport, or page. Use page for whole-page summaries and product details. Defaults to metadata.",
          "type": "string",
        },
        "selector": {
          "description": "CSS selector to read when scope is selector. Leave empty for metadata, selection, viewport, or page reads.",
          "type": "string",
