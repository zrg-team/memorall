  {
    "description": "Use the user's studios with the models they chose: answer typed questions about a text (decision), speak text (speech), transcribe audio, generate images or audio, and run image and text tools. Every result comes back as text; media is saved to Files.",
    "name": "memon_studio",
    "parameters": {
      "description": "Run the user's studios on the computer: decisions, speech, transcripts, images, image and text tools, audio.",
      "properties": {
        "action": {
          "description": "list: open Studio and show which tools have a model, with their voices and tasks; run: run one tool, or a .studio app; save: keep a tool and its settings (questions, voice, task, labels…) as a .studio app on the desktop, ready to run again.",
          "enum": [
            "list",
            "run",
            "save",
          ],
          "type": "string",
        },
        "app": {
          "description": "run: a .studio app, e.g. "~/Analyze User Feedback.studio": its tool and settings are used, so give only the input (text or path).",
          "type": "string",
        },
        "count": {
          "description": "image: how many images (default 1).",
          "type": "number",
        },
        "documents": {
          "description": "text_tools text-ranking: the documents to rank.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "duration": {
          "description": "audio: seconds (default 10).",
          "type": "number",
        },
        "instructions": {
          "description": "speech: how to speak, for models that take it.",
          "type": "string",
        },
        "labels": {
          "description": "text_tools zero-shot-classification: labels to choose from.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "language": {
          "description": "transcribe: the spoken language as an ISO code, if known.",
          "type": "string",
        },
        "multiLabel": {
          "description": "text_tools zero-shot-classification: score each label alone.",
          "type": "boolean",
        },
        "name": {
          "description": "save: the app's name, e.g. "Analyze User Feedback" (saved as ~/Analyze User Feedback.studio), or a path.",
          "type": "string",
        },
        "path": {
          "description": "A file in Files. transcribe: audio or video; image_tools: an image; image: an image to start from (optional).",
          "type": "string",
        },
        "questions": {
          "additionalProperties": {
            "properties": {
              "criteria": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  {
                    "additionalProperties": {
                      "type": "string",
                    },
                    "type": "object",
                  },
                ],
                "description": "choice: the options, ["a", "b"] or {"a": "what a means"}; score: 2-10 levels, lowest first; noul: optional {"true": "…", "false": "…"} wording.",
              },
              "instructions": {
                "description": "The question, in full.",
                "type": "string",
              },
              "type": {
                "description": "choice: pick one option; score: a level; noul: yes or no.",
                "enum": [
                  "choice",
                  "score",
                  "noul",
                ],
                "type": "string",
              },
            },
            "required": [
              "type",
              "instructions",
            ],
            "type": "object",
          },
          "description": "decision: questions keyed by a short id, e.g. { sentiment: { type: "choice", instructions: "…", criteria: ["positive", "negative"] } }.",
          "type": "object",
        },
        "saveTo": {
          "description": "run: also write the whole text result (a transcript, answers, labels) to this file in Files.",
          "type": "string",
        },
        "size": {
          "description": "image: e.g. "1024x1024".",
          "type": "string",
        },
        "speed": {
          "description": "speech: 1 is normal.",
          "type": "number",
        },
        "task": {
          "description": "image_tools, text_tools: the task, only when list shows the model does not fix one.",
          "type": "string",
        },
        "text": {
          "description": "decision: the text or JSON object to decide about; speech: the words to speak; image, audio: the prompt; text_tools: the text to classify, or the query to rank documents by.",
          "type": "string",
        },
        "threshold": {
          "description": "image_tools object-detection: the lowest score to keep.",
          "type": "number",
        },
        "tool": {
          "description": "run: decision (typed questions about a text), speech (text to speech), transcribe (audio to text), image (generate images), image_tools (background removal, depth, detection, captions), text_tools (classify or rank text), audio (music or sound from a prompt).",
          "enum": [
            "decision",
            "speech",
            "transcribe",
            "image",
            "image_tools",
            "text_tools",
            "audio",
          ],
          "type": "string",
        },
        "translate": {
          "description": "transcribe: translate the speech to English instead.",
          "type": "boolean",
        },
        "voice": {
          "description": "speech: a voice id from list.",
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
  },
  {
    "description": "Plan and track work in the Tasks app the user watches and edits too: add a task with its checklist, start it, tick items, finish or drop it. Tasks stay across chats. Keep them as a careful person would: one task per piece of work, and before adding one, continue the open task it belongs to; tick each item as you finish it, so the list always shows where the work stands; when the plan changes, edit the list rather than leaving stale items; when asked to bring a task up to date, check what is really done and fix the whole list in one edit; finish it only when every item is ticked or edited out. Returns the screen.",
    "name": "memon_tasks",
    "parameters": {
      "description": "Keep the tasks you share with the user in the Tasks app.",
      "properties": {
        "action": {
          "description": "add: a new task with \`title\` and its checklist \`items\`; start: begin \`task\` (in progress); check/uncheck: tick one checklist \`item\` of \`task\`; edit: rename \`task\` to \`title\` and/or replace its checklist with \`items\`; done: finish \`task\`; drop: give \`task\` up (it stays as the record).",
          "enum": [
            "add",
            "start",
            "check",
            "uncheck",
            "edit",
            "done",
            "drop",
          ],
          "type": "string",
        },
        "item": {
          "description": "check/uncheck (required): the checklist item's number in the task, from 1.",
          "type": "number",
        },
        "items": {
          "description": "add/edit: the checklist, in order: 3–8 concrete steps, each one you can see is done ("Write the hero copy", not "Think about copy"). edit replaces the whole list: items with the same text keep their tick, "[x] " marks one done and "[ ] " not, so one edit brings every item up to date.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "start": {
          "description": "add: true for a task the user asked for, started at once. Leave out to propose it: it stays new until the user approves it.",
          "type": "boolean",
        },
        "task": {
          "description": "The task's number, #3 in Tasks. start/drop need it; check/uncheck/edit/done act on the task in progress (the screen's "now: #3") when it is left out.",
          "type": "number",
        },
        "title": {
          "description": "add/edit: the outcome, short, as a person would name it: "Landing page for the spring launch", not the request word for word.",
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
  },
  {
    "description": "Show the user a visual (dashboard, report, comparison, chart, table, form) written in OpenUI Lang in the Visualize app, saved as a .openui file they can open again. Returns the screen.",
