exports[`flows-integrations registered contracts > registers every integrations tool contract 2`] = `
[
  {
    "description": "Safely click a selected element in the active co-agent tab. High-impact or sensitive targets are blocked and require user action.",
    "name": "co_agent_click",
    "parameters": {
      "properties": {
        "index": {
          "type": "number",
        },
        "message": {
          "type": "string",
        },
        "selector": {
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Safely type text into a selected text input or textarea in the active co-agent tab. Sensitive fields are blocked.",
    "name": "co_agent_input",
    "parameters": {
      "properties": {
        "index": {
          "type": "number",
        },
        "message": {
          "type": "string",
        },
        "selector": {
          "type": "string",
        },
        "value": {
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Move the visible co-agent cursor to a selector/index or viewport coordinates. Optionally scroll the element into view.",
    "name": "co_agent_move",
    "parameters": {
      "properties": {
        "index": {
          "type": "number",
        },
        "message": {
          "type": "string",
        },
        "mode": {
          "type": "string",
        },
        "scrollIntoView": {
          "type": "boolean",
        },
        "selector": {
          "type": "string",
        },
        "x": {
          "type": "number",
        },
        "y": {
          "type": "number",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Read page context with a simple scope. Default metadata is cheap. Use selector for hovered/focused targets, selection for selected text, viewport for current screen, and page only for whole-page questions. Set outputFormat:'html' to get elements with embedded data-selector attributes — use those selector values directly with co_agent_move to visually point the cursor at matching elements.",
    "name": "co_agent_observe",
    "parameters": {
      "properties": {
        "from": {
          "type": "number",
        },
        "index": {
          "type": "number",
        },
        "maxChars": {
          "type": "number",
        },
        "outputFormat": {
          "type": "string",
        },
        "scope": {
          "type": "string",
        },
        "selector": {
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Query DOM elements in the active co-agent tab. Returns visible state, rects, stable selectors, text/value, and input capability.",
    "name": "co_agent_query",
    "parameters": {
      "properties": {
        "maxResults": {
          "type": "number",
        },
        "selector": {
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Scroll the active co-agent tab window or a selected scrollable element.",
    "name": "co_agent_scroll",
    "parameters": {
      "properties": {
        "behavior": {
          "type": "string",
        },
        "deltaX": {
          "type": "number",
        },
        "deltaY": {
          "type": "number",
        },
        "index": {
          "type": "number",
        },
        "left": {
          "type": "number",
        },
        "message": {
          "type": "string",
        },
        "selector": {
          "type": "string",
        },
        "top": {
          "type": "number",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Access a running sandbox container server. Set useIframe=true to render web UI pages and return the rendered HTML. Omit useIframe (or set false) to call API endpoints and return their response body.",
    "name": "container_web_access",
    "parameters": {
      "properties": {
        "body": {
          "type": "string",
        },
        "headers": {
          "additionalProperties": {
            "type": "string",
          },
          "type": "object",
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS",
          ],
          "type": "string",
        },
        "url": {
          "type": "string",
        },
        "useIframe": {
          "type": "boolean",
        },
      },
      "required": [
        "url",
      ],
      "type": "object",
    },
  },
  {
    "description": "Access a running sandbox container server. Set useIframe=true to render web UI pages in the current thread and return rendered HTML. Omit useIframe (or set false) only for API-style endpoints and return the API response body.",
    "name": "container_web_access_v2",
    "parameters": {
      "properties": {
        "body": {
          "type": "string",
        },
        "headers": {
          "additionalProperties": {
            "type": "string",
          },
          "type": "object",
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS",
          ],
          "type": "string",
        },
        "timeoutMs": {
          "type": "number",
        },
        "url": {
          "type": "string",
        },
        "useIframe": {
          "type": "boolean",
        },
      },
      "required": [
        "url",
      ],
      "type": "object",
    },
  },
  {
    "description": "Edit a document file by replacing text. Finds old_string in the file and replaces it with new_string. Only works on text-based files.",
    "name": "doc_edit",
    "parameters": {
      "properties": {
        "file_path": {
          "type": "string",
        },
        "new_string": {
          "type": "string",
        },
        "old_string": {
          "type": "string",
        },
        "replace_all": {
          "type": "boolean",
        },
      },
      "required": [
        "file_path",
        "old_string",
        "new_string",
      ],
      "type": "object",
    },
  },
  {
    "description": "Move or rename a document file or folder. Provide new_name to rename, target_folder to move, or both to move and rename.",
    "name": "doc_move",
    "parameters": {
      "properties": {
        "new_name": {
          "type": "string",
        },
        "source_path": {
          "type": "string",
        },
        "target_folder": {
          "type": "string",
        },
      },
      "required": [
        "source_path",
      ],
      "type": "object",
    },
  },
  {
    "description": "Read document file content with line numbers. Returns cat -n style output with a header showing total lines and range. Supports text/markdown/other and best-effort text extraction for PDF/Excel.",
    "name": "doc_read",
    "parameters": {
      "properties": {
        "file_path": {
          "type": "string",
        },
        "limit": {
          "type": "number",
        },
        "offset": {
          "type": "number",
        },
      },
      "required": [
        "file_path",
      ],
      "type": "object",
    },
  },
  {
    "description": "Delete a document file or folder. Folders are deleted recursively.",
    "name": "doc_remove",
    "parameters": {
      "properties": {
        "path": {
          "type": "string",
        },
      },
      "required": [
        "path",
      ],
      "type": "object",
    },
  },
  {
    "description": "Search document files and content. Without a pattern, lists files with size/type info. With a pattern, searches text/PDF/Excel content (best-effort) and returns matching lines in ripgrep format. Large or unsupported binaries fall back to path-only matching with a note.",
    "name": "doc_search",
    "parameters": {
      "properties": {
        "case_sensitive": {
          "type": "boolean",
        },
        "file_pattern": {
          "type": "string",
        },
        "max_results": {
          "type": "number",
        },
        "path": {
          "type": "string",
        },
        "pattern": {
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Create or overwrite a document file. If the file exists, updates its content. If new, creates it (with parent folders by default). Only supports text-based files; PDF/Excel are not supported for writing. After using this tool, assistant messages should mention only the created or updated file path, not the file content.",
    "name": "doc_write",
    "parameters": {
      "properties": {
        "content": {
          "type": "string",
        },
        "create_folders": {
          "type": "boolean",
        },
        "file_path": {
          "type": "string",
        },
      },
      "required": [
        "file_path",
        "content",
      ],
      "type": "object",
    },
  },
  {
    "description": "Edit a text file by replacing old_string with new_string. By default only the first occurrence is replaced; set replace_all to true to replace every occurrence. Fails if old_string is not found.",
    "name": "document_fs_edit",
    "parameters": {
      "properties": {
        "file_path": {
          "type": "string",
        },
        "new_string": {
          "type": "string",
        },
        "old_string": {
          "type": "string",
        },
        "replace_all": {
          "type": "boolean",
        },
      },
      "required": [
        "file_path",
        "old_string",
        "new_string",
      ],
      "type": "object",
    },
  },
  {
    "description": "Find paths that match a glob pattern. Supports common glob syntax including **, *, ?, {a,b}, [abc], [!abc], and extglob groups like @(a|b). For ambiguous asset/name searches, combine likely names and extensions in one pattern, e.g. **/*{icon,logo,brand}*.{png,jpg,jpeg,svg,webp,ico}, instead of making repeated narrow calls. Returns matching paths.",
    "name": "document_fs_glob",
    "parameters": {
      "properties": {
        "path": {
          "type": "string",
        },
        "pattern": {
          "type": "string",
        },
      },
      "required": [
        "pattern",
      ],
      "type": "object",
    },
  },
  {
    "description": "Search file content with a JavaScript regex pattern. Returns results in grep-style "file:line:content" format. Supports context lines, minimatch glob filtering, and output modes. Use one broad regex and one broad glob when possible, e.g. pattern="icon|logo|brand" glob="**/*.{md,json,svg,png,jpg}".",
    "name": "document_fs_grep",
    "parameters": {
      "properties": {
        "case_sensitive": {
          "type": "boolean",
        },
        "context": {
          "type": "number",
        },
        "glob": {
          "type": "string",
        },
        "max_results": {
          "type": "number",
        },
        "output_mode": {
          "enum": [
            "content",
            "files_with_matches",
            "count",
          ],
          "type": "string",
        },
        "path": {
          "type": "string",
        },
        "pattern": {
          "type": "string",
        },
      },
      "required": [
        "pattern",
      ],
      "type": "object",
    },
  },
  {
    "description": "List files and directories. Without recursive, shows only immediate children. With recursive: true, shows the full subtree.",
    "name": "document_fs_ls",
    "parameters": {
      "properties": {
        "path": {
          "type": "string",
        },
        "recursive": {
          "type": "boolean",
        },
      },
      "type": "object",
    },
