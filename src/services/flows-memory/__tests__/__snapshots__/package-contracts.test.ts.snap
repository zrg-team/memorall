exports[`flows-memory registered contracts > registers every memory tool contract 2`] = `
[
  {
    "description": "Retrieve nodes and edges from the knowledge graph using one or more queries, optionally scoped by graphId",
    "name": "knowledge_graph",
    "parameters": {
      "properties": {
        "entity": {
          "type": "string",
        },
        "graphId": {
          "type": "string",
        },
        "limit": {
          "type": "number",
        },
        "queries": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "query": {
          "type": "string",
        },
        "relationship": {
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Write nodes and edges to the knowledge graph. Nodes are upserted by name. Edges link two nodes by name.",
    "name": "knowledge_graph_write",
    "parameters": {
      "properties": {
        "edges": {
          "items": {
            "properties": {
              "destinationName": {
                "type": "string",
              },
              "edgeType": {
                "type": "string",
              },
              "factText": {
                "type": "string",
              },
              "sourceName": {
                "type": "string",
              },
            },
            "required": [
              "edgeType",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "graphId": {
          "type": "string",
        },
        "node": {
          "properties": {
            "attributes": {
              "additionalProperties": {},
              "type": "object",
            },
            "name": {
              "type": "string",
            },
            "nodeType": {
              "type": "string",
            },
            "summary": {
              "type": "string",
            },
          },
          "required": [
            "name",
            "nodeType",
          ],
          "type": "object",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Explain where a memory came from using its stored attributes and any source links available in the graph.",
    "name": "memory_explain_source",
    "parameters": {
      "properties": {
        "edgeId": {
          "type": "string",
        },
      },
      "required": [
        "edgeId",
      ],
      "type": "object",
    },
  },
  {
    "description": "Remember a durable user fact, preference, or project-context item in the currently selected memory graph.",
    "name": "memory_remember",
    "parameters": {
      "properties": {
        "confidence": {
          "type": "number",
        },
        "factText": {
          "type": "string",
        },
        "memoryKind": {
          "enum": [
            "fact",
            "preference",
            "project_context",
          ],
          "type": "string",
        },
        "object": {
          "type": "string",
        },
        "objectType": {
          "type": "string",
        },
        "reason": {
          "type": "string",
        },
        "relation": {
          "type": "string",
        },
        "subject": {
          "type": "string",
        },
        "subjectType": {
          "type": "string",
        },
        "tags": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "validAt": {
          "type": "string",
        },
      },
      "required": [
        "subject",
        "relation",
        "object",
        "factText",
      ],
      "type": "object",
    },
  },
  {
    "description": "Forget active memories in the currently selected memory graph by temporally invalidating them, not by deleting rows.",
    "name": "memory_remove",
    "parameters": {
      "properties": {
        "edgeId": {
          "type": "string",
        },
        "limit": {
          "type": "number",
        },
        "query": {
          "type": "string",
        },
        "reason": {
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Retrieve active memories from the currently selected memory graph. Inactive/forgotten memories are excluded unless includeInactive is true.",
    "name": "memory_retrieve",
    "parameters": {
      "properties": {
        "includeInactive": {
          "type": "boolean",
        },
        "limit": {
          "type": "number",
        },
        "memoryKind": {
          "enum": [
            "fact",
            "preference",
            "project_context",
          ],
          "type": "string",
        },
        "query": {
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
  },
  {
    "description": "Update a memory in the currently selected memory graph by invalidating the old fact and creating a replacement.",
    "name": "memory_update",
    "parameters": {
      "properties": {
        "confidence": {
          "type": "number",
        },
        "edgeId": {
          "type": "string",
        },
        "factText": {
          "type": "string",
        },
        "memoryKind": {
          "enum": [
            "fact",
            "preference",
            "project_context",
          ],
          "type": "string",
        },
        "object": {
          "type": "string",
        },
        "objectType": {
          "type": "string",
        },
        "query": {
          "type": "string",
        },
        "reason": {
          "type": "string",
        },
        "relation": {
          "type": "string",
        },
        "subject": {
          "type": "string",
        },
        "subjectType": {
          "type": "string",
        },
        "tags": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "subject",
        "relation",
        "object",
        "factText",
      ],
      "type": "object",
    },
  },
