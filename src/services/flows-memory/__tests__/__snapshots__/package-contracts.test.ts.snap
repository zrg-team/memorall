exports[`flows-memory registered contracts > registers every memory tool contract 1`] = `
[
  "knowledge_graph",
  "knowledge_graph_write",
  "memory_explain_source",
  "memory_remember",
  "memory_remove",
  "memory_retrieve",
  "memory_update",
]
`;

exports[`flows-memory registered contracts > registers every memory tool contract 2`] = `
[
  {
    "description": "Retrieve nodes and edges from the knowledge graph using one or more queries, optionally scoped by graphId",
    "name": "knowledge_graph",
    "parameters": {
      "properties": {
        "entity": {
          "description": "Entity alias for backward compatibility",
          "type": "string",
        },
        "graphId": {
          "description": "Knowledge graph/topic id to scope retrieval",
          "type": "string",
        },
        "limit": {
          "description": "Result limit",
          "type": "number",
        },
        "queries": {
          "description": "Additional knowledge retrieval queries",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "query": {
          "description": "Primary knowledge query",
          "type": "string",
        },
        "relationship": {
          "description": "Specific relationship type to filter edges",
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Write nodes and edges to the knowledge graph. Nodes are upserted by name. Edges link two nodes by name.",
    "name": "knowledge_graph_write",
    "parameters": {
      "properties": {
        "edges": {
          "description": "Facts/edges linking two nodes by name. Omit sourceName or destinationName to use the input node.",
          "items": {
            "properties": {
              "destinationName": {
                "description": "Destination node name — omit to use the input node",
                "type": "string",
              },
              "edgeType": {
                "type": "string",
              },
              "factText": {
                "type": "string",
              },
              "sourceName": {
                "description": "Source node name — omit to use the input node",
                "type": "string",
              },
            },
            "required": [
              "edgeType",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "graphId": {
          "description": "Graph/topic scope",
          "type": "string",
        },
        "node": {
          "description": "Node to create or update by name",
          "properties": {
            "attributes": {
              "additionalProperties": {},
              "type": "object",
            },
            "name": {
              "type": "string",
            },
            "nodeType": {
              "type": "string",
            },
            "summary": {
              "type": "string",
            },
          },
          "required": [
            "name",
            "nodeType",
          ],
          "type": "object",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Explain where a memory came from using its stored attributes and any source links available in the graph.",
    "name": "memory_explain_source",
    "parameters": {
      "properties": {
        "edgeId": {
          "description": "Memory edge id to explain",
          "type": "string",
        },
      },
      "required": [
        "edgeId",
      ],
      "type": "object",
    },
  },
  {
    "description": "Remember a durable user fact, preference, or project-context item in the currently selected memory graph. Give it as subject → relation → object plus the full sentence, e.g. subject "user", relation "prefers", object "dark mode", factText "The user prefers dark mode."",
    "name": "memory_remember",
    "parameters": {
      "properties": {
        "confidence": {
          "description": "How sure, from 0 to 1, e.g. 0.9",
          "type": "number",
        },
        "factText": {
          "description": "The whole memory as one natural-language sentence, e.g. "The user prefers dark mode."",
          "type": "string",
        },
        "memoryKind": {
          "description": "One of: fact, preference, project_context",
          "enum": [
            "fact",
            "preference",
            "project_context",
          ],
          "type": "string",
        },
        "object": {
          "description": "What the subject relates to: the end of subject → relation → object, e.g. "dark mode". Required even when factText already says it.",
          "type": "string",
        },
        "objectType": {
          "description": "Kind of thing the object is, e.g. "setting", "tool"",
          "type": "string",
        },
        "reason": {
          "description": "Why this memory is being saved",
          "type": "string",
        },
        "relation": {
          "description": "How the subject relates to the object, as a short predicate, e.g. "prefers", "works on"",
          "type": "string",
        },
        "subject": {
          "description": "Who or what the memory is about: the start of subject → relation → object, e.g. "user"",
          "type": "string",
        },
        "subjectType": {
          "description": "Kind of thing the subject is, e.g. "person", "project"",
          "type": "string",
        },
        "tags": {
          "description": "A list of short labels, e.g. ["work", "ui"]",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "validAt": {
          "description": "Optional ISO timestamp when valid",
          "type": "string",
        },
      },
      "required": [
        "subject",
        "relation",
        "object",
        "factText",
      ],
      "type": "object",
    },
  },
  {
    "description": "Forget active memories in the currently selected memory graph by temporally invalidating them, not by deleting rows.",
    "name": "memory_remove",
    "parameters": {
      "properties": {
        "edgeId": {
          "description": "Exact memory edge id to remove",
          "type": "string",
        },
        "limit": {
          "type": "number",
        },
        "query": {
          "description": "Search query for memories to remove",
          "type": "string",
        },
        "reason": {
          "description": "Why the memory is being removed",
          "type": "string",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Search the currently selected memory graph by meaning and by text. Covers both memories saved through memory_remember and knowledge extracted from saved pages, files, and chats, unless scope is 'active'. Inactive/forgotten memories are excluded unless includeInactive is true.",
    "name": "memory_retrieve",
    "parameters": {
      "properties": {
        "includeInactive": {
          "type": "boolean",
        },
        "limit": {
          "type": "number",
        },
        "memoryKind": {
          "enum": [
            "fact",
            "preference",
            "project_context",
          ],
          "type": "string",
        },
        "query": {
          "description": "What memory to search for",
          "type": "string",
        },
        "scope": {
          "description": "'all' (default) searches everything in the graph, including knowledge extracted from saved pages, files, and chats. 'active' searches only memories saved through memory_remember.",
          "enum": [
            "active",
            "all",
          ],
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
  },
  {
    "description": "Update a memory in the currently selected memory graph by invalidating the old fact and creating a replacement. Identify the old memory with edgeId or query, then give the replacement in full as subject → relation → object plus factText.",
    "name": "memory_update",
    "parameters": {
      "properties": {
        "confidence": {
          "description": "How sure, from 0 to 1, e.g. 0.9",
          "type": "number",
        },
        "edgeId": {
          "description": "Exact memory edge id to update",
          "type": "string",
        },
        "factText": {
          "description": "The whole memory as one natural-language sentence, e.g. "The user prefers dark mode."",
          "type": "string",
        },
        "memoryKind": {
          "description": "One of: fact, preference, project_context",
          "enum": [
            "fact",
            "preference",
            "project_context",
          ],
          "type": "string",
        },
        "object": {
          "description": "What the subject relates to: the end of subject → relation → object, e.g. "dark mode". Required even when factText already says it.",
          "type": "string",
        },
        "objectType": {
          "description": "Kind of thing the object is, e.g. "setting", "tool"",
          "type": "string",
        },
        "query": {
          "description": "Search query for memory to update",
          "type": "string",
        },
        "reason": {
          "description": "Why this memory is being saved",
          "type": "string",
        },
        "relation": {
          "description": "How the subject relates to the object, as a short predicate, e.g. "prefers", "works on"",
          "type": "string",
        },
        "subject": {
          "description": "Who or what the memory is about: the start of subject → relation → object, e.g. "user"",
          "type": "string",
        },
        "subjectType": {
          "description": "Kind of thing the subject is, e.g. "person", "project"",
          "type": "string",
        },
        "tags": {
          "description": "A list of short labels, e.g. ["work", "ui"]",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "subject",
        "relation",
        "object",
        "factText",
      ],
      "type": "object",
    },
  },
]
`;
