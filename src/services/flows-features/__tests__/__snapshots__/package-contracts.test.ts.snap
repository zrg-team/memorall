exports[`flows-features registered contracts > registers every features tool contract 1`] = `
[
  "render_artifact",
]
`;

exports[`flows-features registered contracts > registers every features tool contract 2`] = `
[
  {
    "description": "Append a standard artifact to the graph output as an assistant message. The tool result is only a normal OpenAI tool message; the artifact itself is added to graph state.",
    "name": "render_artifact",
    "parameters": {
      "properties": {
        "content": {
          "type": "string",
        },
        "identifier": {
          "type": "string",
        },
        "title": {
          "type": "string",
        },
        "type": {
          "enum": [
            "text/html",
            "text/uri-list",
            "html",
            "url",
            "application/hyperframes",
          ],
          "type": "string",
        },
      },
      "required": [
        "type",
        "content",
      ],
      "type": "object",
    },
  },
]
`;
